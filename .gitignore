# ---------------------------------------------------------

# AirTrack .gitignore

# ---------------------------------------------------------

# ---------------------------

# Environment / configuration

# ---------------------------

.env
.env.*
!.env.example
.env.client
.env.server

# Local workspace files

AirTrack1.code-workspace
.vscode/
.idea/

# ---------------------------

# SSH material

# ---------------------------

ssh/
ssh/*

# ---------------------------

# Keys (server only)

# ---------------------------

keys/
keys/*
!keys/airtrack_public.pem

# ---------------------------

# Python artifacts

# ---------------------------

**pycache**/
*.pyc
*.pyo
*.pyd
*.pytest_cache/
*.coverage
.mypy_cache/

# Virtual environments

venv/
.venv/
env/

# ---------------------------

# Logs / backups

# ---------------------------

logs/
logs/*
*.log

backups/
app/backup.sql

# ---------------------------

# Databases

# ---------------------------

*.db
*.sqlite
*.sqlite3

# ---------------------------

# OS junk

# ---------------------------

.DS_Store
Thumbs.db

# ---------------------------

# Development junk

# ---------------------------

MASTER.txt
*.bak
*.bak-pre-*
*.patch
*.csv
*audit*
tree.txt
update_headers.py

# ---------------------------

# Docker overrides

# ---------------------------

docker-compose.override.yml

# ---------------------------

# Local runtime data

# ---------------------------

app/app_data/
# License files — never commit
*.lic
app_data/

# Per-install module runtime state (e.g. Meerkat's real opt-in flag and
# heartbeat sequence_number, app/modules/meerkat/state.json). Must never
# be tracked: routes/admin_tools_routes.py's self-update routes run
# `git reset --hard origin/main` followed by `git clean -fd` on every
# "check for updates" pull. `git clean -fd` deletes any untracked file
# NOT covered by .gitignore -- without this entry, a routine update
# would wipe an install's real consent state on every single pull, not
# just on the rare branch reset that originally surfaced this bug (see
# CLAUDE_MEMORY / DEFERRED_IDEAS item #12).
app/modules/*/state.json

# ---------------------------

# Update system cache

# ---------------------------

app/static/updates/

# ---------------------------

# Scripts not for clients

# ---------------------------

app/scripts/

# ---------------------------

# Large aircraft registries

# ---------------------------

app/registries/
app/routes/VH-VXA_*

# ---------------------------

# Temporary exports

# ---------------------------

exports/
tmp/
*.tmp

app/static/uploads/
/static/
logs/
app_data/

# Loose data files in app root
app/*.sql
app/*.zip
app/*_bak.html
app/*_backup*.sql

__pycache__/
*.pyc
*.pyo
*.lic

# backup file convention (matches other AirTrack repos)
*.bak
*.bak-*
*.bak_*

# ---------------------------
# Windows build artifacts (PyInstaller / Inno Setup, gate3)
# ---------------------------
build/
dist/
Output/
_internal/
*.spec
AirTrack.exe
*_build.zip
*.msi
